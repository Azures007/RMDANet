"""Runtime patch for CenterGuidedPooling (DRSE).

Env vars:
  DRSE_TUNE=1                enable tuning patch
  DRSE_CENTER_SIZE=5         center crop size (default 3)
  DRSE_TEMP=0.30             attention temperature (default 0.12)
  DRSE_INIT=0.6,0.3,0.1      initial softmax weights (global,center,attended)

  DRSE_RESIDUAL=1            residual DRSE: pooled = gap + a*(guided - gap)
  DRSE_ALPHA_LOGIT=-4.0      initial logit of a (sigmoid(-4)=0.018)
"""
import os

import torch
import torch.nn.functional as F

ENABLED = os.environ.get("DRSE_TUNE", "0") == "1"
CENTER_SIZE = int(os.environ.get("DRSE_CENTER_SIZE", "5"))
TEMP = float(os.environ.get("DRSE_TEMP", "0.30"))
INIT = tuple(float(x) for x in os.environ.get("DRSE_INIT", "0.6,0.3,0.1").split(","))
RESIDUAL = os.environ.get("DRSE_RESIDUAL", "0") == "1"
ALPHA_LOGIT = float(os.environ.get("DRSE_ALPHA_LOGIT", "-4.0"))


def patch(model_module):
    if not ENABLED:
        return
    cls = model_module.CenterGuidedPooling
    if getattr(cls, "_drse_patched", False):
        return

    orig_init = cls.__init__
    orig_forward = cls.forward

    def __init__(self, channels, center_size=3, attention_temperature=0.12, mode="guided"):
        orig_init(self, channels, center_size=CENTER_SIZE,
                  attention_temperature=TEMP, mode=mode)
        with torch.no_grad():
            self.gate[-1].bias.copy_(torch.tensor(INIT, dtype=torch.float32).log())
        if RESIDUAL and self.mode == "guided":
            self._alpha_logit = torch.nn.Parameter(torch.tensor(float(ALPHA_LOGIT)))

    def forward(self, x):
        pooled, weights, attention_map = orig_forward(self, x)
        if RESIDUAL and getattr(self, "mode", "guided") == "guided":
            gap = F.adaptive_avg_pool2d(x, 1).flatten(1)
            alpha = torch.sigmoid(self._alpha_logit)
            pooled = gap + alpha * (pooled - gap)
        return pooled, weights, attention_map

    cls.__init__ = __init__
    cls.forward = forward
    cls._drse_patched = True
    print(f"[drse] tuned center={CENTER_SIZE} temp={TEMP} init={INIT} "
          f"residual={RESIDUAL} alpha_logit={ALPHA_LOGIT}", flush=True)
